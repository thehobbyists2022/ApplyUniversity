# 複製此檔為 .env 並填入你的 key (https://api.data.gov/signup 免費註冊)
# 此檔可進 Git (不含真實 key)
COLLEGE_SCORECARD_API_KEY=your_api_key_here

# Supabase Auth + Premium subscription
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe Checkout (Pro plans)
VITE_STRIPE_MONTHLY_URL=https://buy.stripe.com/your-monthly-link
VITE_STRIPE_SEASON_PASS_URL=https://buy.stripe.com/your-seasonpass-link
